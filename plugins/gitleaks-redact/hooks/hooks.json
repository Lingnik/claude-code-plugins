{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Read|Grep|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/output_redact.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
